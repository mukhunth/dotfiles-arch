[mediaplayer]
command=~/.scripts/i3blocks/mediaplayer
instance=spotify
interval=5
signal=10

[gpu-load]
command=~/.scripts/i3blocks/gpu-load
label=GPU
interval=5
#min_width=GPU 100% 100% 100% 100%
#T_WARN=70
#T_CRIT=90

[cpu_usage]
command=~/.scripts/i3blocks/cpu_usage
interval=5
LABEL=CPU
#min_width=CPU: 100.00%
#T_WARN=50
#T_CRIT=80
#DECIMALS=2

[memory]
command=free -h | awk '/^Mem:/ {print "RAM "$3}'
interval=5

[volume-pulseaudio]
command=~/.scripts/i3blocks/volume-pulseaudio
interval=5
signal=1
#MIXER=[determined automatically]
#SCONTROL=[determined automatically]
##exposed format variables: ${SYMB}, ${VOL}, ${INDEX}, ${NAME}
#LONG_FORMAT="${SYMB} ${VOL}% [${INDEX}:${NAME}]"
#SHORT_FORMAT="${SYMB} ${VOL}% [${INDEX}]"
#AUDIO_HIGH_SYMBOL='>'
#AUDIO_MED_THRESH=50
#AUDIO_MED_SYMBOL='~'
#AUDIO_LOW_THRESH=0
#AUDIO_LOW_SYMBOL='<'
#AUDIO_DELTA=5
#DEFAULT_COLOR="#ffffff"
#MUTED_COLOR="#a0a0a0"
#USE_ALSA_NAME=0
#USE_DESCRIPTION=0
## SUBSCRIBE=1 requires interval=persist and always uses LONG_FORMAT
#SUBSCRIBE=0

[battery2]
command=~/.scripts/i3blocks/battery2
markup=pango
interval=30

[time]
command=date +%b' '%d' '%a' '%I:%M%p
interval=5
color=#00ff66
