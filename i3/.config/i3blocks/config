color=#ebdbb2

[mediaplayer]
command=~/.scripts/i3blocks/mediaplayer
instance=spotify
interval=5
signal=10

[gpu-load]
command=~/.scripts/i3blocks/gpu-load
label=GPU
interval=10

[cpu_usage]
command=~/.scripts/i3blocks/cpu_usage
interval=10
LABEL=CPU
DECIMALS=1

[memory]
command=free -h | awk '/^Mem:/ {print "RAM "$3}'
interval=10

[volume-pulseaudio]
command=~/.scripts/i3blocks/volume-pulseaudio
interval=10
signal=1
LONG_FORMAT="${SYMB} ${VOL}% [${NAME}]"
DEFAULT_COLOR="#ebdbb2"
MUTED_COLOR="#a89984"

[battery2]
command=~/.scripts/i3blocks/battery2
markup=pango
interval=30

[date]
command=date +'  '%a' '%d' '%b
interval=300

[time]
command=date +%I:%M' '%p
interval=5
color=#33ff00
