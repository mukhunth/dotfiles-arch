color=#ebdbb2
signal=5

[mediaplayer]
command=~/.scripts/i3blocks/mediaplayer
label=  
instance=spotify
interval=5

[gpu-load]
command=~/.scripts/i3blocks/gpu-load
label= GPU 
interval=10

[cpu_usage]
command=~/.scripts/i3blocks/cpu_usage
LABEL=龍 CPU 
DECIMALS=1
interval=10

[memory]
command=free -h | awk '/^Mem:/ {print " RAM "$3}'
interval=10

[volume-pulseaudio]
command=~/.scripts/i3blocks/volume-pulseaudio
LONG_FORMAT="${SYMB} ${VOL}%"
#LONG_FORMAT="${SYMB} ${VOL}% [${NAME}]"
DEFAULT_COLOR="#ebdbb2"
MUTED_COLOR="#7b7061"
interval=once
signal=10

