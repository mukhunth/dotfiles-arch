set $mod Mod4
set $ws1 "1:  "
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8:  "
set $ws9 "9:  "
set $ws10 "10:  "
set $sep " | "
set $ac #33ff00
set $bg #00000099
#[80]cc [70]b3 [60]99 [50]80
exec --no-startup-id feh --bg-fill $HOME/Pictures/wp
exec_always --no-startup-id picom --experimental-backends

font pango:DejaVu Sans Mono 10
default_border pixel 0
default_floating_border pixel 1
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="mpv" instance="gl"] floating enable, resize set height 1080, move position center
for_window [class="Blueman-manager" instance="blueman-manager"] floating enable, move position center

bindsym Mod1+e exec --no-startup-id exitmenu
bindsym $mod+Return exec --no-startup-id konsole
bindsym $mod+d exec --no-startup-id dmenu_run -nf '#33ff00' -nb '#000000' -sf '#000000' -sb '#33ff00' -fn 'noto sans:size=11' -i -b
bindsym $mod+Shift+d exec --no-startup-id i3-dmenu-desktop --dmenu="dmenu -nf '#33ff00' -nb '#000000' -sf '#000000' -sb '#33ff00' -fn 'noto sans:size=11' -i -b"
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+c move position center
bindsym $mod+u [urgent=latest] focus
bindsym $mod+s split toggle
bindsym $mod+Shift+s layout toggle split
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle
floating_modifier $mod
bindsym $mod+i gaps inner current plus 5
bindsym $mod+o gaps outer current plus 5
bindsym $mod+Shift+i gaps inner current minus 5
bindsym $mod+Shift+o gaps outer current minus 5
bindsym $mod+Shift+r restart

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8 exec --no-startup-id pidof spotify || flatpak run com.spotify.Client
bindsym $mod+9 workspace $ws9 exec --no-startup-id pidof dolphin || dolphin
bindsym $mod+0 workspace $ws10 exec --no-startup-id pidof firefox || firefox
bindsym $mod+b workspace back_and_forth
bindsym $mod+n workspace prev
bindsym $mod+m workspace next
for_window [class="Spotify"] move --no-auto-back-and-forth to workspace $ws8
assign [class="dolphin"] $ws9
assign [class="firefox"] $ws10

bar {
    position top
    tray_output none
    separator_symbol $sep
    status_command i3blocks
    workspace_min_width 30
    strip_workspace_numbers yes
    font pango:NotoSansNerdFont 10.5
    i3bar_command i3bar --transparency
    colors {
    separator $ac
    background $bg
    # class            border backgr. text
    focused_workspace  $bg    $bg     $ac
    inactive_workspace $bg    $bg     #7b7061
    urgent_workspace   $bg    $bg     #ff3300
    }
}

# Plasma compatibility improvements
for_window [title="Desktop — Plasma"] kill; floating enable; border none
for_window [title="plasma-desktop"] floating enable; border none
for_window [title="win7"] floating enable; border none
for_window [class="plasmashell"] floating enable
for_window [class="Plasma"] floating enable; border none
for_window [class="systemsettings"] floating enable
for_window [class="krunner"] floating enable; border none
for_window [class="Kmix"] floating enable; border none
for_window [class="Klipper"] floating enable; border none
for_window [class="Plasmoidviewer"] floating enable; border none
for_window [class="plasmashell" window_type="notification"] border none
for_window [class="plasmashell" window_type="dock"] border none
no_focus [class="plasmashell" window_type="notification"]
no_focus [class="plasmashell" window_type="dock"]

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left 20
bindsym $mod+Shift+j move down 20
bindsym $mod+Shift+k move up 20
bindsym $mod+Shift+l move right 20
bindsym $mod+Shift+Left move left 20
bindsym $mod+Shift+Down move down 20
bindsym $mod+Shift+Up move up 20
bindsym $mod+Shift+Right move right 20

# resize focused window
bindsym $mod+Mod1+h resize shrink width 20
bindsym $mod+Mod1+j resize shrink height 20
bindsym $mod+Mod1+k resize grow height 20
bindsym $mod+Mod1+l resize grow width 20
bindsym $mod+Mod1+Left resize shrink width 20
bindsym $mod+Mod1+Down resize shrink height 20
bindsym $mod+Mod1+Up resize grow height 20
bindsym $mod+Mod1+Right resize grow width 20

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10
bindsym $mod+Shift+b move container to workspace back_and_forth, workspace back_and_forth
bindsym $mod+Shift+n move container to workspace prev, workspace prev
bindsym $mod+Shift+m move container to workspace next, workspace next

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
